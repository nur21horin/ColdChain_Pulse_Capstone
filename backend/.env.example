PORT=3000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-coldchain-pulse-2026-medswift
JWT_EXPIRES_IN=24h
DATABASE_URL=postgresql://postgres:password@localhost:5432/coldchain_pulse?schema=public

# Telemetry Simulator settings
SIMULATOR_INTERVAL_MS=30000
SIMULATOR_API_URL=http://localhost:3000/api/v1/telemetry/ingest

# Temperature Threshold Defaults (Celsius)
DEFAULT_MIN_TEMP=2.0
DEFAULT_MAX_TEMP=8.0
WARNING_TEMP_BUFFER=0.5
CRITICAL_BREACH_DURATION_MINUTES=10
